plot(
irr_smooth,
legend.only = TRUE,
col = irr_cols,
breaks = irr_breaks,
smallplot = c(0.9, 0.92, 0.25, 0.75),
axis.args = list(
at = seq(0.2, 1.0, 0.1),
labels = sprintf("%.1f", seq(0.2, 1.0, 0.1)),
cex.axis = 0.75
),
legend.args = list(
text = "Irrigation\nfraction",
side = 3,
font = 2,
line = 1,
cex = 0.9
)
)
# glacier legend
legend(
"bottomright",
inset = c(-0.08, 0.01),
legend = "Glacier",
fill = "blue",
border = "blue",
bty = "n",
cex = 0.95
)
# 7. Global inset map
# -----------------------------
par(
fig = c(0.01, 0.21, 0.01, 0.21),
mar = c(0, 0, 0, 0),
new = TRUE,
xpd = FALSE
)
plot(
World_countries,
col = "grey85",
border = "grey60",
lwd = 0.25,
axes = FALSE,
box = TRUE
)
par(
fig = c(0.01, 0.21, 0.01, 0.21),
mar = c(0, 0, 0, 0),
new = TRUE,
xpd = FALSE
)
# red rectangle showing main map domain
rect(
xmin(map_ext),
ymin(map_ext),
xmax(map_ext),
ymax(map_ext),
border = "red",
lwd = 1.5
)
dev.off()
}
