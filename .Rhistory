# cleaner label with white halo
label_halo <- function(x, y, label, cex = 0.75, srt = 0) {
text(x, y, label, cex = cex, srt = srt, col = "white", font = 3)
text(x, y, label, cex = cex, srt = srt, col = "white", font = 3, offset = 0.5)
text(x, y, label, cex = cex, srt = srt, col = "black", font = 3)
}
label_halo(78.2, 38.0, "Karakoram", cex = 0.80, srt = 3)
label_halo(70, 34.0, "Western Himalaya", cex = 0.80, srt = 0)
label_halo(86.5, 31.5, "Central Himalaya", cex = 0.80, srt = 15)
label_halo(92.5, 27.5, "Eastern Himalaya", cex = 0.80, srt = 5)
label_halo(88.5, 36.2, "Tibetan Plateau", cex = 0.8, srt = 15)
label_halo(77, 27.0, "Indo-Gangetic Plain", cex = 0.80, srt = -30)
text(65, 18, "Arabian Sea", col = "white", cex = 1.1, font = 3)
text(88.5, 16, "Bay of Bengal", col = "white", cex = 1.1, font = 3)
# country boundary
plot(
world_crop,
add = TRUE,
border = adjustcolor("grey20", alpha.f = 0.5),
lwd = 0.5
)
# working extent box
plot(
Working_extent,
add = TRUE,
border = "black",
lwd = 2,
lty = 2
)
